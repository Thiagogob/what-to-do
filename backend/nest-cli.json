{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "tsconfig.json"
  },
  "monorepo": true,
  "root": ".",
  "projects": {
    "auth-e2e": {
      "type": "application",
      "root": "apps/auth-e2e",
      "entryFile": "main",
      "sourceRoot": "apps/auth-e2e/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth-e2e/tsconfig.json"
      }
    },
    "backend": {
      "type": "application",
      "root": ".",
      "entryFile": "main",
      "sourceRoot": "src",
      "compilerOptions": {
        "tsConfigPath": "tsconfig.json"
      }
    }
  }
}